# ===========================================
# Server
# ===========================================
NODE_ENV=development
PORT=5001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (sandbox)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email
# In development, emails go to Ethereal by default (a preview URL is printed in
# the server logs — nothing is actually delivered). Set EMAIL_TRANSPORT=smtp to
# use the real SMTP credentials below instead. Production always uses SMTP.
EMAIL_TRANSPORT=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
EMAIL_FROM=noreply@ecommerce.local

# Client URL (for CORS + emails)
CLIENT_URL=http://localhost:3000

# ===========================================
# Client (Next.js — prefixed NEXT_PUBLIC_)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_WS_URL=http://localhost:5001
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxx

# ===========================================
# Production deployment (docker-compose.prod.yml on the VPS) — see DEPLOYMENT.md
# ===========================================
# Public domain of the API, served over HTTPS by Caddy (Let's Encrypt).
API_DOMAIN=api.tondomaine.com
# MongoDB root credentials (the prod compose enables auth).
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-strong-password
# Host port bindings (server is bound to 127.0.0.1 behind Caddy).
SERVER_PORT=5001
CLIENT_PORT=3000
# In production set CLIENT_URL to the deployed front (Vercel), e.g.
# CLIENT_URL=https://app.tondomaine.com
